# ---------------------------------------------------------------
# Billboard Fund site. Infra settings live here.
# Coin details (name, ticker, mint, mascot, links, colors) can be set here as defaults
# OR later in the Admin page (/#/admin) without a redeploy. Admin values win.
# ---------------------------------------------------------------

# DEMO=true shows clearly labeled sample data. Keep false for the real site.
DEMO=false

# Long random string for the Admin page. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Any Solana mainnet RPC (public one is rate limited; a free Helius/QuickNode key is better)
RPC_URL=https://api.mainnet-beta.solana.com

# Public URL of the site (used in share-to-X links and link previews), e.g. https://yourcoin-billboards.onrender.com
PUBLIC_URL=

PORT=3000
DB_PATH=./data/tracker.sqlite
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# --- Coin (leave empty before launch -> "Launching soon" state) ---
TOKEN_MINT=
REWARDS_WALLET=
COIN_NAME=
TOKEN_SYMBOL=
SITE_TITLE=Billboard Fund
TAGLINE=
LAUNCH_NOTE=
MASCOT_URL=
WEBSITE_URL=
X_URL=
TIKTOK_URL=
TELEGRAM_URL=
DEXSCREENER_URL=

# X account that design submissions are shared to for review
REVIEW_X_HANDLE=RiseofMemes

# Theme
THEME_PRIMARY="#7c5cff"
THEME_SECONDARY="#22c55e"
THEME_ACCENT="#5eead4"
THEME_SNOW=false

# Voting / treasury display
MIN_HOLDING=100000
RESERVE_SOL=0.05
NEXT_BILLBOARD_TARGET_USD=50
